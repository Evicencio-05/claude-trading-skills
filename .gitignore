# OS-generated files
.DS_Store
Thumbs.db

# Python cache & build artifacts
__pycache__/
.pytest_cache/
*.py[cod]
*.pyo
*.so
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Node (Robinhood MCP setup — mcp-remote)
node_modules/

# Tool configurations
.idea/
.vscode/
.env
.envrc
.mcp.json
.cursor/mcp.json
config/agentic_copilot.yaml

# Logs & temp
logs/
!reports/logs/
!reports/logs/**
*.log
*.tmp

# Jupyter
.ipynb_checkpoints/

# Keep structured reports and logs tracked
# Ignore intermediate skill run artifacts only
reports/market/**/*.json
reports/screeners/**/*.json
reports/portfolio/*.json
reports/prompts/*.json
reports/*.json
reports/archives/*.json
reports/skill-generation-log/*.json
reports/skill-improvement-log/*.json
# Intermediate FMP prefetch dumps (local only)
reports/logs/research_prefetch/
reviews/
# Accidental misplaced state trees
project-docs/state/

# Robinhood auth (never commit)
.tokens/
robinhood.pickle

# Per-symbol runtime state (e.g. parabolic-short SSR carryover files).
# Kept out of commits so production state never leaks into the repo.
state/*
!state/prompt_learnings.yaml
# Sync state (contains position data — keep local)
state/pending_ingest.json
state/synced_positions.json

# CI artifacts
htmlcov/
.coverage
# .secrets.baseline is tracked — needed by detect-secrets pre-commit hook
