<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  SETUP: Replace $HOME and $PROJECT_DIR before installing.
    sed "s|\$HOME|$HOME|g; s|\$PROJECT_DIR|$(pwd)|g" \
      launchd/com.trading.robinhood-sync.plist > ~/Library/LaunchAgents/com.trading.robinhood-sync.plist
    launchctl load ~/Library/LaunchAgents/com.trading.robinhood-sync.plist

  NOTE: First run requires interactive 2FA — do NOT use launchd for the first run.
  Run manually: python3 scripts/robinhood_sync.py
  After auth token is cached at ~/.tokens/, subsequent runs are headless.
  Schedule here (8:30 AM daily) only activates after first manual run succeeds.
-->
<dict>
	<key>Label</key>
	<string>com.trading.robinhood-sync</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>$PROJECT_DIR/scripts/run_robinhood_sync.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>$PROJECT_DIR</string>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>HOME</key>
		<string>$HOME</string>
	</dict>

	<key>StandardOutPath</key>
	<string>$PROJECT_DIR/logs/launchd_robinhood_sync.log</string>

	<key>StandardErrorPath</key>
	<string>$PROJECT_DIR/logs/launchd_robinhood_sync_error.log</string>

	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
